# Optional: Claude for story understanding and the written statement of facts. Use ONE of these.
# Without either, Golden Hour still traces funds and drafts every document from templates.
ANTHROPIC_API_KEY=
# ...or reach the same Claude model through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# PUBLIC_SITE_URL=https://your-domain.example   (shown on your OpenRouter dashboard)

# Optional: point at another Blockscout instance (default: Ethereum mainnet)
# BLOCKSCOUT_URL=https://eth.blockscout.com/api/v2

# Optional: a free Blockscout PRO API key (https://dev.blockscout.com). Needed for Base, Arbitrum and
# Polygon, whose public instances block server-side requests. Ethereum, OP Mainnet and Gnosis work without it.
# BLOCKSCOUT_API_KEY=

# Optional: a free TronGrid key (https://www.trongrid.io). Tron tracing works without it, just more slowly.
# TRONGRID_API_KEY=

# Hosting
# TRACE_BUDGET_SECONDS=150   # lower to 90 on AWS App Runner (it ends requests after 120 s)
# TRUSTED_PROXY_HOPS=1       # proxies in front of the app (1 for App Runner or an ALB)
# LLM_PAUSE_SECONDS=300      # after a billing/key error, skip the model this long (calls answer instantly from the script)
# CASES_PER_10_MIN=8
# LOOKUPS_PER_10_MIN=20
